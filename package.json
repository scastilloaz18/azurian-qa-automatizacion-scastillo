{
  "name": "azurian-qa-automation",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "node scripts/clean-results.mjs && cucumber-js",
    "test:api": "node scripts/clean-results.mjs && cucumber-js --tags @api",
    "test:ui": "node scripts/clean-results.mjs && cucumber-js --tags @ui",
    "test:crear": "node scripts/clean-results.mjs && cucumber-js --tags @crear",
    "test:leer": "node scripts/clean-results.mjs && cucumber-js --tags @leer",
    "test:editar": "node scripts/clean-results.mjs && cucumber-js --tags @editar",
    "test:eliminar": "node scripts/clean-results.mjs && cucumber-js --tags @eliminar",
    "test:scenario": "node scripts/clean-results.mjs && cucumber-js",
    "typecheck": "tsc --noEmit",
    "allure:generate": "allure generate ./allure-results",
    "allure:open": "allure open ./allure-report"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@cucumber/messages": "^34.2.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.17.0",
    "allure": "^3.21.0",
    "allure-cucumberjs": "^3.14.0",
    "dotenv": "^18.0.8",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  },
  "allowScripts": { "esbuild@0.28.2": true }
}
